    {
      "name": "Material Settings",
      "file": "material_view.html?mode=settings",
      "type": "control",
      "role": "settings",
      "obs": true,
      "modes": ["sync", "server"]
    },
    {
      "name": "Material All",
      "file": "material_view.html?mode=all",
      "type": "control",
      "role": "control",
      "obs": false,
      "modes": ["sync", "server"]
    }
  ]
